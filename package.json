{
  "homepage": "https://resume.eunsu.pro/",
  "name": "eunsu-resume",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "next dev",
    "fetch:velog": "bun scripts/fetch-velog.ts",
    "build": "bun run fetch:velog && bun run lint && bun run prettier && next build",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ./src/db/configs/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "start": "next start",
    "lint": "eslint . --report-unused-disable-directives",
    "prettier": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "harness:check": "node .claude/harness/check.mjs --mode principles",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@neondatabase/serverless": "^1.0.2",
    "@octokit/rest": "^21.1.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.7",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.469.0",
    "motion": "^12.34.0",
    "next": "^16.2.4",
    "pretendard": "^1.3.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.1.0",
    "remark-breaks": "^4.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
